{
  "compilerOptions": {
    "declaration": false,
    "esModuleInterop": true,
    "module": "commonjs",
    "outDir": ".build",
    "rootDir": "src",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2015",
    "lib": [
      "ESNext"
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
}
