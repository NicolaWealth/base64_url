{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "dist/types",
    "module": "commonjs",
    "outDir": ".build",
    "target": "ES2015",

    "composite": false,
    "incremental": false,
    "declarationMap": false,
    "inlineSourceMap": false,
    "inlineSources": false
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}
